{
  "name": "world-of-noah",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "account_id": "7f6a7b0733b0a9155bda2256b67c5f48",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "noah.worldofz.info", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
